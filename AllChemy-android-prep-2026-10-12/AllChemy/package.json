{
  "name": "allchemy",
  "version": "0.2.0-android-prep",
  "private": true,
  "description": "AllChemy – offline chemistry workbench (MVP). Plain browser JavaScript, no runtime dependencies; Playwright is a test-only dev dependency.",
  "scripts": {
    "test": "node tests/run_all.js",
    "test:setup": "playwright install chromium",
    "test:api": "node tests/t_app_api.js",
    "test:ui": "node tests/t_app_ui.js",
    "test:android": "node tests/t_android_static.js && node tests/t_android_assets.js",
    "serve": "python3 -m http.server 8080 --directory www"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  }
}
