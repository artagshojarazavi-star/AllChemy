<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background = no white flash while the WebView starts; doubles as the launch splash. -->
    <style name="Theme.AllChemy" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/ac_bg</item>
        <item name="android:navigationBarColor">@color/ac_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
